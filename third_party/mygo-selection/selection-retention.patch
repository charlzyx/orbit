+func TestOrbitSelectionNavigationInteractionIsNarrow(t *testing.T) {
+	for _, mode := range []string{"enabled", "not-registered", "registration-removed", "wrong-owner", "disabled-owner", "disabled-shell", "removed-owner", "new-identity", "outside", "ordinary-control"} {
+		t.Run(mode, func(t *testing.T) {
+			identity := "session"
+			register, disabled := mode != "not-registered", false
+			disabledShell, showOwner := false, true
+			clicks := 0
+			tt := NewTester(func(c *Context) {
+				Column(c).Size(500, 300).Children(func() {
+					scope := Element{}
+					if showOwner {
+						scope = Column(c.Key("scope")).Size(500, 100).Selectable().Disabled(disabled).RetainTextSelection(identity)
+					}
+					scope.Children(func() { Text(c, "Selection must survive only designated navigation").Height(40) })
+					other := Column(c.Key("other")).Size(500, 40).Selectable().RetainTextSelection("unrelated")
+					other.Children(func() { Text(c, "Other scope") })
+					rail := Column(c.Key("rail")).Label("rail").Size(200, 40).Disabled(disabledShell)
+					if register {
+						owner := scope
+						if mode == "wrong-owner" {
+							owner = other
+						}
+						rail.RetainTextSelectionInteraction(owner)
+					}
+					rail.Children(func() {
+						if Button(c, "Navigation").Clicked() {
+							clicks++
+						}
+					})
+					if Button(c, "Ordinary action").Clicked() {
+						clicks++
+					}
+				})
+			}, 500, 300)
+			r, _ := tt.Find("Selection must survive only designated navigation")
+			tt.Press(r.X+1, r.Y+10)
+			tt.Move(r.X+r.W-1, r.Y+10)
+			tt.Release(r.X+r.W-1, r.Y+10)
+			tt.Key(Cmd, KeyC)
+			want := tt.Clipboard()
+			if !strings.Contains(want, "Selection") {
+				t.Fatal("selection fixture", want)
+			}
+			switch mode {
+			case "not-registered", "registration-removed":
+				register = false
+			case "disabled-owner":
+				disabled = true
+			case "disabled-shell":
+				disabledShell = true
+			case "removed-owner":
+				showOwner = false
+			case "new-identity":
+				identity = "changed"
+			}
+			tt.Frame()
+			switch mode {
+			case "disabled-shell":
+				r, _ := tt.Find("rail")
+				tt.Press(r.X+10, r.Y+10)
+				tt.Release(r.X+10, r.Y+10)
+			case "outside":
+				tt.Press(490, 290)
+				tt.Release(490, 290)
+			case "ordinary-control":
+				if e := tt.Click("Ordinary action"); e != nil {
+					t.Fatal(e)
+				}
+			default:
+				if e := tt.Click("Navigation"); e != nil && mode != "disabled-shell" {
+					t.Fatal(e)
+				}
+			}
+			tt.SetClipboard("sentinel")
+			tt.Key(Cmd, KeyC)
+			if mode == "enabled" {
+				if tt.Clipboard() != want || clicks != 1 {
+					t.Fatal("designated navigation lost selection/action", tt.Clipboard(), clicks)
+				}
+			} else if tt.Clipboard() != "sentinel" {
+				t.Fatal("broadened selection exception", mode, tt.Clipboard())
+			}
+		})
+	}
+}
