+func TestOrbitSelectionInteractionRejectsForeignWindowBeforeLookup(t *testing.T) {
+	var foreign Element
+	other := NewTester(func(c *Context) { foreign = Column(c).Size(100, 100).RetainTextSelection("foreign") }, 100, 100)
+	other.Frame()
+	tt := NewTester(func(c *Context) {
